name: Merge Clash Nodes

on:
  schedule:
    - cron: '0 23 * * *'  # 每天北京时间早上7点（UTC时间的23点）
  workflow_dispatch:  # 支持手动执行

jobs:
  merge_clash_nodes:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v2

    - name: Set up Python
      uses: actions/setup-python@v2
      with:
        python-version: '3.9'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install pyyaml requests geoip2

    - name: Run merge and update YAML
      run: |
        python scripts/merge_clash_nodes.py
